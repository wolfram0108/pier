#!/bin/sh /etc/rc.common
# Служба панели для procd.
#
# Панель работает постоянно и переживает перезагрузку роутера. Ядро sing-box
# поднимается своей службой и панелью не запускается: ядро в системе одно,
# оно стартует при загрузке и не останавливается (§ 4.4 ТЗ).
#
# Почему respawn. Панель, упавшая по любой причине, обязана вернуться сама:
# без неё переключатели ядра остаются в том положении, в каком их застали, и
# трафик идёт по последнему назначению — но новые решения принимать некому.
#
# Почему procd_set_param stderr. Панель не ведёт собственных файлов журнала на
# флеше (Ф-1.9): всё диагностическое уходит в системный журнал, а сколько его
# хранить, решает система.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/pier
CONF=/etc/pier
TMP=/tmp/pier

start_service() {
	mkdir -p "$CONF" "$TMP"

	procd_open_instance
	procd_set_param command "$PROG" -root "$CONF" -tmp "$TMP"
	procd_set_param stderr 1
	# Пять попыток с интервалом 5 с — те же параметры, что у службы ядра (П-5):
	# панель узнаёт их у procd и различает по ним «падает, попытки идут» и
	# «система прекратила попытки» (П-21, Ф-7.14).
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	# Файлы провайдеров живут в tmpfs и после остановки не нужны: ядро читает
	# их только пока работает панель. Настройки и снимки на флеше не трогаем.
	rm -rf "$TMP"
}

service_triggers() {
	procd_add_reload_trigger "pier"
}

reload_service() {
	stop
	start
}
